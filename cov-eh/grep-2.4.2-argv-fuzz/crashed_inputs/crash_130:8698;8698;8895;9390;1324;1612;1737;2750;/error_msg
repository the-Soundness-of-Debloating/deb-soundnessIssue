train_input/grep1.dat:  if (ACCEPTS_IN_CONTEXT(d->states[s].newline, 1, d->states[s].letter, 0,
train_input/grep1.dat:      s, *d))
train_input/grep1.dat:    d->success[s] |= 4;
train_input/grep1.dat:  if (ACCEPTS_IN_CONTEXT(d->states[s].newline, 0, d->states[s].letter, 1,
train_input/grep1.dat:      s, *d))
train_input/grep1.dat:    d->success[s] |= 2;
