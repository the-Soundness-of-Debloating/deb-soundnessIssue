train_input/grep1.dat:    {
train_input/grep1.dat:      for (i = 0; i < d->tralloc; ++i)
train_input/grep1.dat:	if (d->trans[i])
train_input/grep1.dat:	  {
train_input/grep1.dat:	    free((ptr_t) d->trans[i]);
train_input/grep1.dat:	    d->trans[i] = NULL;
train_input/grep1.dat:	  }
train_input/grep1.dat:	else if (d->fails[i])
