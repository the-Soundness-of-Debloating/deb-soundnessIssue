train_input/grep1.dat:     and fail arrays are allocated large enough to hold a pointer for the
train_input/grep1.dat:     largest state mentioned in the table. */
train_input/grep1.dat:  for (i = 0; i < NOTCHAR; ++i)
train_input/grep1.dat:    if (trans[i] >= d->tralloc)
train_input/grep1.dat:      {
train_input/grep1.dat:	int oldalloc = d->tralloc;
train_input/grep1.dat:
train_input/grep1.dat:	while (trans[i] >= d->tralloc)
train_input/grep1.dat:	  d->tralloc *= 2;
train_input/grep1.dat:	REALLOC(d->realtrans, int *, d->tralloc + 1);
train_input/grep1.dat:	d->trans = d->realtrans + 1;
train_input/grep1.dat:	REALLOC(d->fails, int *, d->tralloc);
train_input/grep1.dat:	REALLOC(d->success, int, d->tralloc);
train_input/grep1.dat:	REALLOC(d->newlines, int, d->tralloc);
train_input/grep1.dat:	while (oldalloc < d->tralloc)
train_input/grep1.dat:	  {
train_input/grep1.dat:	    d->trans[oldalloc] = NULL;
train_input/grep1.dat:	    d->fails[oldalloc++] = NULL;
train_input/grep1.dat:	  }
train_input/grep1.dat:      }
train_input/grep1.dat:
train_input/grep1.dat:  /* Keep the newline transition in a special place so we can use it as
train_input/grep1.dat:     a sentinel. */
train_input/grep1.dat:  d->newlines[s] = trans['\n'];
train_input/grep1.dat:  trans['\n'] = -1;
train_input/grep1.dat:
train_input/grep1.dat:  if (ACCEPTING(s, *d))
train_input/grep1.dat:    d->fails[s] = trans;
train_input/grep1.dat:  else
train_input/grep1.dat:    d->trans[s] = trans;
train_input/grep1.dat:}
