/* scanner for a toy Pascal-like language */

%{
/* need this for the call to atof() below */
#include <math.h>
%}

DIGIT	[0-9]
ID	[a-z][a-z0-9]*

%%

main(argc, argv)
int argc;
char **argv;
	{
	++argv, --argc;	/* skip over program name */
	if(argc > 0)
		yyin = fopen(argv[0], "r");
	else
		yyin = stdin;

	yylex();
	} 
