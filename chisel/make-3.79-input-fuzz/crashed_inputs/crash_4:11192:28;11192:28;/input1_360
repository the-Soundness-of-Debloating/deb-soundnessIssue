	    README INSTALL hello.texi hello.?? hello.??s gpl.texinfo \
	    configure configure.in \
	    mkinstalldirs texinfo.tex hello.info testdata TAGS

all: hello
.PHONY: all

.PHONY: info dvi
info: hello.info
dvi: hello.dvi

.c.o:
	$(CC) -c $(CPPFLAGS) $(DEFS) $(CFLAGS) $<

